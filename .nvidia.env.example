# Vertivo — NVIDIA NIM keys, separadas de `.env`.
# COPY to `.nvidia.env` (gitignored) and fill locally.
# NEVER commit real values, NEVER paste into chat/log.
# SERVER-SIDE ONLY. Never expose in any Flutter/web client bundle.
# Format: nvapi-... (created at build.nvidia.com -> Settings -> API Keys).
# TWO separate keys — each its OWN variable and OWN value:
NVIDIA_API_KEY_INTERNAL_STAGING=
NVIDIA_API_KEY_PUBLIC_PROD=
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1

# Optional: default NIM models to call (override per use case).
# NVIDIA_NIM_DETECTION_MODEL=
# NVIDIA_NIM_VLM_MODEL=

# vision-core reads ONE key per environment as VISION_NVIDIA_API_KEY. Locally,
# point it at the staging key:
#   VISION_NVIDIA_API_KEY = NVIDIA_API_KEY_INTERNAL_STAGING  (for local dev)
VISION_NVIDIA_API_KEY=
