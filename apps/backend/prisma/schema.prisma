// Prisma schema — HAB-26 motor de estados de negociación.
//
// Los términos viajan como JSON versionado (columna `terms`); el resumen
// pactado se congela en `summary` al aceptar. El audit es append-only:
// la app solo inserta en `transition_audits` (sin updates/deletes en código).
// `attemptId` UNIQUE da idempotencia a nivel DB ante reintentos.

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Negotiation {
  id               String   @id @db.Uuid
  listingId        String   @map("listing_id") @db.Uuid
  tenantId         String   @map("tenant_id")
  ownerId          String   @map("owner_id")
  status           String
  round            Int
  deadline         DateTime @db.Timestamptz(6)
  terms            Json
  summary          Json?
  tenantConfirmed  Boolean  @default(false) @map("tenant_confirmed")
  ownerConfirmed   Boolean  @default(false) @map("owner_confirmed")
  closeReason      String?  @map("close_reason")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  audits           TransitionAudit[]

  @@index([status, deadline])
  @@map("negotiations")
}

model TransitionAudit {
  id            String      @id @db.Uuid
  negotiationId String      @map("negotiation_id") @db.Uuid
  negotiation   Negotiation @relation(fields: [negotiationId], references: [id], onDelete: Restrict)
  actor         String
  at            DateTime    @db.Timestamptz(6)
  from          String
  to            String
  round         Int
  attemptId     String      @unique @map("attempt_id") @db.Uuid

  @@index([negotiationId])
  @@map("transition_audits")
}

// HAB-46: libro de renta de capital inmobiliario.
// Sin token OIDC y sin payload de TRIBU-CR. event_id y (owner_id, period)
// son únicos para que un reintento no duplique el pago ni la declaración.

model SignedRentalContract {
  contractId String   @id @map("contract_id")
  ownerId    String   @map("owner_id")
  signedAt   DateTime @map("signed_at") @db.Timestamptz(6)

  @@map("signed_rental_contracts")
}

model RentalIncomePayment {
  eventId    String   @id @map("event_id")
  contractId String   @map("contract_id")
  ownerId    String   @map("owner_id")
  grossCrc   BigInt   @map("gross_crc")
  paidAt     DateTime @map("paid_at") @db.Timestamptz(6)
  period     String
  included   Boolean

  @@index([ownerId, period])
  @@map("rental_income_payments")
}

model RentalIncomeDeclaration {
  ownerId        String  @map("owner_id")
  period         String
  grossCrc       BigInt  @map("gross_crc")
  taxableBaseCrc BigInt  @map("taxable_base_crc")
  incomeTaxCrc   BigInt  @map("income_tax_crc")
  ivaCrc         BigInt  @map("iva_crc")
  status         String
  late           Boolean @default(false)
  notified       Boolean @default(false)

  @@id([ownerId, period])
  @@map("rental_income_declarations")
}
