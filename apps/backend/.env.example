# Copiar a .env (no commitear el .env real).
DATABASE_URL="postgresql://habitanexus:habitanexus@localhost:5432/habitanexus?schema=public"
# Origen permitido a pg_net para el trigger de expiración (inyectado en deploy).
BACKEND_PUBLIC_URL="http://localhost:3000"
# Secreto compartido entre pg-cron/pg_net y Nest para POST /negotiations/expire-rounds.
CRON_SECRET="cambiar-en-cada-entorno"
PORT=3000
