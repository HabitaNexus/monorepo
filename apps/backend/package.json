{
  "name": "@habitanexus/backend",
  "version": "0.1.0",
  "private": true,
  "description": "HabitaNexus backend — Nest + Prisma. Primer módulo de dominio: HAB-26 motor de estados de negociación.",
  "license": "UNLICENSED",
  "scripts": {
    "build": "rm -rf dist && swc src generated -d dist --ignore '**/*.spec.ts'",
    "start": "node dist/src/main.js",
    "start:dev": "swc src -d dist --watch",
    "start:nest": "nest start",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:cov": "jest --coverage",
    "prisma:validate": "prisma validate",
    "prisma:generate": "prisma generate"
  },
  "dependencies": {
    "@nestjs/common": "12.0.3",
    "@nestjs/core": "12.0.3",
    "@nestjs/platform-express": "12.0.3",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "7.10.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.2",
    "dotenv": "17.2.2",
    "pg": "^8.23.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.3",
    "@nestjs/testing": "12.0.3",
    "@swc/cli": "^0.8.1",
    "@swc/core": "1.16.2",
    "@swc/jest": "0.2.39",
    "@types/express": "5.0.3",
    "@types/jest": "30.0.0",
    "@types/node": "22.18.1",
    "jest": "30.1.3",
    "prisma": "7.10.0",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=22"
  }
}
