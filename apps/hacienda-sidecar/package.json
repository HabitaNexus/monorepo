{
  "name": "@habitanexus/hacienda-sidecar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "tsc -p tsconfig.test.json && mkdir -p reports && node --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=junit --test-reporter-destination=reports/junit.xml dist-test/*.test.js",
    "smoke": "node dist/smoke.js",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint src",
    "format:check": "prettier --check \"src/**/*.ts\" \"scripts/**/*.mjs\" eslint.config.mjs package.json tsconfig.json tsconfig.test.json",
    "format": "prettier --write \"src/**/*.ts\" \"scripts/**/*.mjs\" eslint.config.mjs package.json tsconfig.json tsconfig.test.json"
  },
  "dependencies": {
    "@dojocoding/hacienda-sdk": "0.4.1",
    "@grpc/grpc-js": "^1.13.4",
    "@grpc/proto-loader": "^0.7.15"
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "eslint": "10.12.0",
    "prettier": "3.9.10",
    "typescript": "^5.8.3",
    "typescript-eslint": "8.71.2"
  }
}
