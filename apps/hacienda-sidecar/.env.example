# Copy to apps/hacienda-sidecar/.env (gitignored). Do not commit the real file.
# Quote the password: it often contains @ * & ^ which break unquoted shells and curl.
# make dev-hacienda-idp-handshake writes reports/idp-handshake.csv (gitignored).
# That CSV records status and token length. It does not store the token or the password.
HACIENDA_ENVIRONMENT=sandbox
HACIENDA_IDP_USERNAME='cpf-01-0000-0000@stag.comprobanteselectronicos.go.cr'
HACIENDA_PASSWORD=''
